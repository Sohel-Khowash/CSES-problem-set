import java.io.*;

public class Main {

    static final int LOG = 31;
    static int[][] up;

    static class FastScanner {
        private final InputStream in = System.in;
        private final byte[] buffer = new byte[1 << 16];
        private int ptr = 0, len = 0;

        private int read() throws IOException {
            if (ptr >= len) {
                len = in.read(buffer);
                ptr = 0;
                if (len <= 0) return -1;
            }
            return buffer[ptr++];
        }

        int nextInt() throws IOException {
            int c;
            do {
                c = read();
            } while (c <= ' ');

            int num = 0;
            while (c > ' ') {
                num = num * 10 + c - '0';
                c = read();
            }
            return num;
        }
    }

    public static void main(String[] args) throws IOException {

        FastScanner fs = new FastScanner();

        int n = fs.nextInt();
        int q = fs.nextInt();

        up = new int[n + 1][LOG];

        // Build the binary lifting table.
        for (int i = 2; i <= n; i++) {

            int parent = fs.nextInt();
            up[i][0] = parent;

            for (int j = 1; j < LOG; j++) {
                up[i][j] = up[up[i][j - 1]][j - 1];
            }
        }

        StringBuilder sb = new StringBuilder();

        while (q-- > 0) {

            int node = fs.nextInt();
            int k = fs.nextInt();

            for (int j = 0; j < LOG; j++) {
                if ((k & (1 << j)) != 0) {
                    node = up[node][j];
                }
            }

            sb.append(node == 0 ? -1 : node).append('\n');
        }

        System.out.print(sb);
    }
}
